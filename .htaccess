# 安全配置
# 防止直接访问敏感文件和目录

# 禁止访问配置文件
<FilesMatch "(?i)^(\.htaccess|config\.php|\.env|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 禁止访问备份文件
<FilesMatch "(?i)\.(bak|backup|old|orig|tmp|swp|save|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 禁止访问 inc 目录
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^inc/ - [F,L]
</IfModule>

# 禁止访问 docs 目录（开发文档：版本日志/规范含备份路径等敏感信息，严禁暴露公网）
<IfModule mod_rewrite.c>
    RewriteRule ^docs/ - [F,L]
</IfModule>

# 禁止访问 logs 目录（开发日志/调试文件）
<IfModule mod_rewrite.c>
    RewriteRule ^logs/ - [F,L]
</IfModule>

# 禁止访问 backup 目录（全量备份 bf.zip 含数据库配置等敏感数据，严禁暴露公网）
<IfModule mod_rewrite.c>
    RewriteRule ^backup/ - [F,L]
</IfModule>

# 安全响应头
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # 限制 CSP（宽松模式，允许内联样式和脚本以兼容现有功能）
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; font-src 'self' data:; connect-src 'self' https: http:; frame-ancestors 'self'"
</IfModule>

# 隐藏服务器版本信息
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>
ServerTokens Prod
ServerSignature Off

# 防止目录列表
Options -Indexes
